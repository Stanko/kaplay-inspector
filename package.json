{
  "name": "@stanko/kaplay-inspector",
  "description": "A dev tool for Kaplay which allows you to explore and inspect the game object tree real time.",
  "private": false,
  "version": "0.3.4",
  "type": "module",
  "main": "./dist/init.js",
  "types": "./dist/init.d.ts",
  "files": [
    "./dist",
    "./public"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "preview": "vite preview",
    "copy-css": "cp ./src/styles/styles.css ./dist/",
    "build": "tsc -b && rm -rf ./docs && vite build && touch ./docs/.nojekyll",
    "build-lib": "rm -rf ./dist && tsc -p ./tsconfig-lib.json && npm run copy-css",
    "prepare": "cp ./pre-commit ./.git/hooks/pre-commit && chmod +x ./.git/hooks/pre-commit",
    "prepublish": "npm run build-lib",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "kaplay": "^4000.0.0-alpha.27.1"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "kaplay": "^4000.0.0-alpha.27.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Stanko/kaplay-inspector.git"
  },
  "keywords": [
    "kaplay",
    "inspector",
    "dev tools"
  ],
  "author": "Stanko",
  "bugs": {
    "url": "https://github.com/Stanko/kaplay-inspector/issues"
  },
  "homepage": "https://muffinman.io/kaplay-inspector/"
}
